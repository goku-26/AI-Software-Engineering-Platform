# DevForge AI Environment Variables

# Server Config
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/devforge
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=devforge_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=devforge_refresh_token_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# AI Config (For Phase 4+)
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# GitHub OAuth (For Phase 2+)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Frontend URL
VITE_API_BASE_URL=http://localhost:5000/api
